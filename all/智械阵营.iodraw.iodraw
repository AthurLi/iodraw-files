        <mxCell id="NBrAbyyLTIE8ZhSehUdL-73" value="&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;有具身 (Embodied)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;拥有完整的物理躯体，受物理法则约束&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" vertex="1" parent="NBrAbyyLTIE8ZhSehUdL-71">
