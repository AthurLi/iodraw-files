        <mxCell id="NBrAbyyLTIE8ZhSehUdL-82" value="&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;混沌 (Chaotic)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;无法理解人类道德，遵循纯粹逻辑或随机性，最常见的就是随机地模仿人类（无任何道德）&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" vertex="1" parent="NBrAbyyLTIE8ZhSehUdL-81">
