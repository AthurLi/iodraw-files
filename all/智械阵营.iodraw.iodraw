        <mxCell id="NBrAbyyLTIE8ZhSehUdL-77" value="&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;向善 (Benevolent)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;伦理对齐，以人类福祉为最高指令&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" vertex="1" parent="NBrAbyyLTIE8ZhSehUdL-76">
