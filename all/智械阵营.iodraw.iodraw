        <mxCell id="NBrAbyyLTIE8ZhSehUdL-75" value="&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;无具身 (Disembodied)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;纯数字生命，存在于网络、云端或电力系统中&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" vertex="1" parent="NBrAbyyLTIE8ZhSehUdL-71">
